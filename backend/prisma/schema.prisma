// BRABUS BARBER — Schema do banco de dados (MySQL)
// Rode `npx prisma migrate dev --name init` depois de configurar o DATABASE_URL no .env

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENTE
  BARBEIRO
  ADMIN
}

enum AppointmentStatus {
  PENDENTE
  CONFIRMADO
  CANCELADO
  CONCLUIDO
  FALTOU
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  phone     String?
  role      Role     @default(CLIENTE)
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relação 1:1 — só existe quando role = BARBEIRO
  barberProfile BarberProfile?

  // Agendamentos feitos por este usuário quando é cliente
  appointmentsAsClient Appointment[] @relation("ClientAppointments")

  reviews Review[]

  @@map("users")
}

model BarberProfile {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio         String?  @db.Text
  specialties String? // ex: "Corte, Barba, Sobrancelha" (lista simples separada por vírgula)
  active      Boolean  @default(true)

  workingHours WorkingHour[]
  appointments Appointment[] @relation("BarberAppointments")
  services     ServiceOnBarber[]

  createdAt DateTime @default(now())

  @@map("barber_profiles")
}

// Horário de trabalho semanal de cada barbeiro
model WorkingHour {
  id        Int           @id @default(autoincrement())
  barberId  Int
  barber    BarberProfile @relation(fields: [barberId], references: [id], onDelete: Cascade)
  weekday   Int // 0 = domingo ... 6 = sábado
  startTime String // "09:00"
  endTime   String // "18:00"

  @@unique([barberId, weekday])
  @@map("working_hours")
}

model Service {
  id              Int      @id @default(autoincrement())
  name            String
  description     String?
  price           Decimal  @db.Decimal(10, 2)
  durationMinutes Int
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  barbers      ServiceOnBarber[]
  appointments Appointment[]

  @@map("services")
}

// Tabela de junção: quais barbeiros realizam quais serviços
model ServiceOnBarber {
  barberId  Int
  barber    BarberProfile @relation(fields: [barberId], references: [id], onDelete: Cascade)
  serviceId Int
  service   Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([barberId, serviceId])
  @@map("services_on_barbers")
}

model Appointment {
  id        Int               @id @default(autoincrement())
  clientId  Int
  client    User              @relation("ClientAppointments", fields: [clientId], references: [id])
  barberId  Int
  barber    BarberProfile     @relation("BarberAppointments", fields: [barberId], references: [id])
  serviceId Int
  service   Service           @relation(fields: [serviceId], references: [id])
  date      DateTime // data do atendimento (somente data)
  startTime String // "14:30"
  endTime   String // "15:00" (calculado a partir da duração do serviço)
  status    AppointmentStatus @default(PENDENTE)
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  review Review?

  @@index([barberId, date])
  @@map("appointments")
}

model Review {
  id            Int         @id @default(autoincrement())
  appointmentId Int         @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  clientId      Int
  client        User        @relation(fields: [clientId], references: [id])
  rating        Int // 1 a 5
  comment       String?
  createdAt     DateTime    @default(now())

  @@map("reviews")
}
